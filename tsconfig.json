{
    "include": ["src"],
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "dist",

        "module": "nodenext",
        "target": "esnext",
        "types": [],

        "sourceMap": true,
        "declaration": false,
        "declarationMap": false,

        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        // Unused parameters are named _x (TS exempts the underscore prefix).
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        // Off: noPropertyAccessFromIndexSignature only flags env reads and record indexes, no correctness gain.

        "strict": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    }
}
