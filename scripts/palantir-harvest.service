# Palantir harvester: builds the weekly planning index and publishes it to
# mauria-api. Installed on the harvester machine (src/palantir-daemon.ts, run from dist/).
#
# User, WorkingDirectory, EnvironmentFile and the WireGuard interface are placeholders:
# set them to the harvester machine's values in the installed copy.
#
# After each git pull, run `npm run build` (tsc needs the devDependencies), then:
#   sudo cp scripts/palantir-harvest.service /etc/systemd/system/
#   sudo cp scripts/palantir-harvest.timer  /etc/systemd/system/
#   sudo systemctl daemon-reload            # otherwise systemd keeps the old unit
#   sudo systemctl enable --now palantir-harvest.timer

[Unit]
Description=Palantir harvester - weekly Junia planning index
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=palantir
WorkingDirectory=/opt/palantir
EnvironmentFile=/etc/palantir/harvest.env
# The harvest must never run on the machine's own IP: a Junia ban would hit
# it instead of the API, but the "+" runs these as root regardless of User=,
# and a failed ExecStartPre aborts the whole service before any Aurion call.
ExecStartPre=+/usr/bin/wg-quick up wg-harvest
ExecStart=/usr/bin/env node dist/palantir-daemon.js
ExecStopPost=+/usr/bin/wg-quick down wg-harvest
# Harvest plus publish retries (up to 3 h by default).
TimeoutStartSec=4h
