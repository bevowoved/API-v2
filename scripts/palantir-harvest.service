[Unit]
Description=Palantir harvester - weekly Junia planning index
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=palantir
WorkingDirectory=/opt/palantir
EnvironmentFile=/etc/palantir/harvest.env
ExecStartPre=+/usr/bin/wg-quick up wg-harvest
ExecStart=/usr/bin/env node dist/palantir-daemon.js
ExecStopPost=+/usr/bin/wg-quick down wg-harvest
TimeoutStartSec=4h
