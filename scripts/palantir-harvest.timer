[Unit]
Description=Palantir harvester - weekly trigger (Sunday 00:05 Paris)

[Timer]
# The index expires on the Saturday-to-Sunday night; harvest right after,
# at a quiet hour with no deploy waves around. The calendar names Europe/Paris
# because the harvester machine runs on London time; systemd handles both DST
# shifts. Persistent replays a missed run after a reboot.
OnCalendar=Sun *-*-* 00:05:00 Europe/Paris
Persistent=true

[Install]
WantedBy=timers.target
