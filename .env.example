# Required
SUPABASE_URL=
# public anon key
SUPABASE_KEY=
# server only; also derives the session and publish tokens
SUPABASE_SERVICE_KEY=

# Optional: leave empty for the default
# error reporting, off when empty
SENTRY_DSN=
# 8080
PORT=
# 0.0.0.0
HOST=
# stopgap idle-GC tickle for nodejs/node#66564; on for Node 24, 26.0-26.12 and 27+, off otherwise; 0 forces off
# MAURIA_IDLE_TICKLE=
# max most-recently-active Aurion accounts kept warm upstream (LRU); 0 disables the bound
# AURION_KEEPER_MAX=64
# keeper pauses while this many upstream requests are in flight; 0 disables the pause
# AURION_KEEPER_SKIP_HOT=16
# outbound Aurion socket pool width; 0 or unset = 8, 32 on Fly
# AURION_MAX_SOCKETS=8
# cap on the shared cache entries (the byte cap is fixed at 48 MiB)
# SUPABASE_MAX_ENTRIES=32768
# cap on print sessions kept per credential
# PRINT_MAX_SESSIONS=512
# cap on accounts whose background refresh is paused after a failure
# AURION_BAKE_MAX=4096
# production
SENTRY_ENVIRONMENT=
# commit SHA, set by the deploy
SENTRY_RELEASE=
# derived from SUPABASE_SERVICE_KEY
PALANTIR_PUBLISH_TOKEN=

# Harvest daemon (dist/palantir-daemon.js) reads its own file, PALANTIR_ENV_FILE:
# AURION_EMAIL, AURION_PASSWORD, PALANTIR_PUBLISH_URL=https://<app>/palantir/publish, PALANTIR_PUBLISH_TOKEN
# defaults: PALANTIR_DELAY_MS=400 PALANTIR_WORKERS=1 PALANTIR_DATA_DIR=scripts/data
# PALANTIR_PUBLISH_ATTEMPTS=6 PALANTIR_PUBLISH_RETRY_MS=1800000
